@@
 function runHf(args, cwd, opts = {}) {
   const { quiet = false, ...spawnOpts } = opts;
@@
-  const r = npxSync(['--yes', `hyperframes@${HYPERFRAMES_VERSION}`, ...args], {
+  const cli = process.env.NAROVA_HF_CLI;
