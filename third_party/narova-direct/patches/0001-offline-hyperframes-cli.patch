+  const r = spawnSync(process.execPath, [cli, ...args], {
     cwd,
     ...(capture ? { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 } : { stdio: 'inherit' }),
     ...spawnOpts,
   });
